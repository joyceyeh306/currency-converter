<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cypress_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="影片瘦身"
            android:textColor="@color/cypress_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="壓小影片，或只留下 MP3。新檔會存回原影片所在資料夾，原始影片預設保留。"
            android:textColor="@color/cypress_text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/selectButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/cypress_primary"
            android:text="① 選擇影片"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/cypress_panel"
            android:lineSpacingExtra="3dp"
            android:padding="15dp"
            android:text="尚未選擇影片"
            android:textColor="@color/cypress_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="② 要怎麼處理？"
            android:textColor="@color/cypress_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/qualityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/q1080"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:buttonTint="@color/radio_tint"
                android:checked="true"
                android:text="1080p  清晰（建議）"
                android:textColor="@color/cypress_text"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/q720"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:buttonTint="@color/radio_tint"
                android:text="720p  省空間"
                android:textColor="@color/cypress_text"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/q480"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:buttonTint="@color/radio_tint"
                android:text="480p  很省空間"
                android:textColor="@color/cypress_text"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/qMp3"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:buttonTint="@color/radio_tint"
                android:text="只匯出 MP3 音檔（192 kbps）"
                android:textColor="@color/cypress_text"
                android:textSize="18sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/estimateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/cypress_panel"
            android:lineSpacingExtra="3dp"
            android:padding="15dp"
            android:text="選擇影片後會顯示預估大小與輸出檔名"
            android:textColor="@color/cypress_text_secondary"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/deleteOriginalCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:buttonTint="@color/radio_tint"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="處理成功後刪除原始影片"
            android:textColor="@color/cypress_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/compressButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/cypress_primary_dark"
            android:enabled="false"
            android:text="③ 開始處理"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="18dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/cypress_primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/cypress_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/originalPolicyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="原始影片保留"
            android:textColor="@color/cypress_hint"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
