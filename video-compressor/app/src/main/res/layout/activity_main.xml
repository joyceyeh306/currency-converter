<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="影片瘦身"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="把大影片壓小，或只留下 MP3 音檔。原始影片不會被刪除。"
            android:textSize="17sp" />

        <Button
            android:id="@+id/selectButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="① 選擇影片"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/fileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="尚未選擇影片"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="② 要怎麼處理？"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/qualityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <RadioButton
                android:id="@+id/q1080"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:checked="true"
                android:text="1080p 清晰（建議）"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/q720"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="720p 省空間"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/q480"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="480p 很省空間"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/qMp3"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="只匯出 MP3 音檔（192 kbps）"
                android:textSize="18sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/estimateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="選擇影片後會顯示預估大小"
            android:textSize="16sp" />

        <Button
            android:id="@+id/compressButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:enabled="false"
            android:text="③ 開始處理"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="22dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="17sp" />

    </LinearLayout>
</ScrollView>
