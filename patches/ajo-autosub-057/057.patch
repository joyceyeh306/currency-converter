+        // This is a targeted device workaround to TEST, not proof of root cause.
+        // No changes to 054 tone mapping, 056 RGB matrix, captions or frame rate.
+        Transformer.Builder transformerBuilder = new Transformer.Builder(context);
+        if (ExportFrameBudget057.useBoundedFrames(inputHdr, diagnosticMode)) {
