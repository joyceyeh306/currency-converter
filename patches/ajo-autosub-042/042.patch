+    /** 042: present each locally decoded phrase with its own original-video times.
+     * Nothing gets added or overwritten until the user taps an explicit choice.
+     */
+    private void showWhisperReviewCandidates(List<Caption> options,Uri source,Caption selected) {
+        if(video==null || !video.equals(source) || options==null || options.isEmpty())return;
+        final String[] entries=new String[options.size()];
+        for(int i=0;i<options.size();i++){
+            Caption c=options.get(i);
+            String t=c.text.replace('\n',' ');
+            if(t.length()>42)t=t.substring(0,42)+"…";
+            entries[i]=Caption.time(c.startMs,false)+" ～ "+Caption.time(c.endMs,false)+
+                "  "+t+(WhisperReviewCandidates.resemblesExisting(c,captions)?" 〔已有近似字幕〕":"");
+        }
+        new AlertDialog.Builder(this).setTitle("042 局部辨識候選（可重疊）")
+            .setMessage("以下時間是 Whisper 的估計，可能有錯字或重複。選中一項後可新增獨立字幕，或只替換目前選取的一句；不會自動縮短其他字幕。")
+            .setItems(entries,(d,which)->{
+                if(video==null || !video.equals(source))return;
+                Caption proposal=options.get(which);
+                boolean duplicate=WhisperReviewCandidates.resemblesExisting(proposal,captions);
+                AlertDialog.Builder choice=new AlertDialog.Builder(this)
+                    .setTitle("確認局部辨識")
+                    .setMessage("文字："+proposal.text+"\n候選時間："+
+                        Caption.time(proposal.startMs,false)+" ～ "+Caption.time(proposal.endMs,false)+
+                        (duplicate?"\n\n已有時間重疊且文字相近的字幕，請避免重複新增。":"")+
+                        "\n\n新增的字幕允許與其他句同時顯示，請檢查時間及文字。")
+                    .setNegativeButton("取消",null)
+                    .setPositiveButton("新增這句並編輯",(dd,ww)->{
+                        if(video==null || !video.equals(source))return;
+                        if(WhisperReviewCandidates.resemblesExisting(proposal,captions)){
+                            toast("已存在近似字幕；若需要兩句相同文字，請使用手動新增");return;
+                        }
+                        Caption added=proposal.copy();
+                        captions.add(added);
+                        captions.sort(Comparator.comparingLong(x->x.startMs));
+                        showCaptions();scheduleSaveCaptions();openCaptionEditor(added);
+                    });
+                if(selected!=null && captions.contains(selected)){
+                    final String before=selected.text;
+                    choice.setNeutralButton("只替換選取句的文字",(dd,ww)->{
+                        if(video==null || !video.equals(source) || !captions.contains(selected) ||
+                           !before.equals(selected.text))return;
+                        selected.text=proposal.text; // keep exact original times and styles
+                        showCaptions();scheduleSaveCaptions();openCaptionEditor(selected);
+                    });
+                }
+                choice.show();
+            }).setNegativeButton("關閉",null).show();
     }
 
