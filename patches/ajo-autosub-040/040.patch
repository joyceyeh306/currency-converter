+    private synchronized File prepareReviewPcm(Uri source) throws Exception {
+        File dest=new File(getCacheDir(),"ajo-040-review-full.pcm");
+        if(reviewPcmSource!=null && reviewPcmSource.equals(source) && dest.isFile() && dest.length()>32000L) return dest;
+        if(dest.exists() && !dest.delete())throw new java.io.IOException("無法更新暫存音訊");
+        PcmDecoder.decode(getApplicationContext(),source,dest,cancelled,ms->{});
+        if(cancelled.get())throw new java.io.IOException("已取消");
+        if(!dest.isFile()||dest.length()<9600L)throw new java.io.IOException("影片音訊不足");
+        reviewPcm=dest;
+        reviewPcmSource=source;
+        return dest;
+    }
