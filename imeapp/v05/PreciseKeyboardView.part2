    private float heightScale() { return settings.getInt("keyboard_height", 90) / 100f; }
    private boolean learningEnabled() { return settings.getBoolean("learning_enabled", true); }

    @Override protected void onMeasure(int widthSpec, int heightSpec) {
        int w = MeasureSpec.getSize(widthSpec);
        int body = Math.round(w * IH / IW * heightScale());
        setMeasuredDimension(w, candH() + body);
    }

    private float sx(float x) { return x / IW * getWidth(); }
    private float sy(float y) { return candH() + y / IH * (getHeight() - candH()); }
    private RectF rect(float x1, float y1, float x2, float y2) {
        return new RectF(sx(x1), sy(y1), sx(x2), sy(y2));
    }

    private void loadCangjie() {
        try (BufferedReader b = new BufferedReader(new InputStreamReader(
                getContext().getAssets().open("cangjie_prefix.tsv"), StandardCharsets.UTF_8))) {
            String line;
            while ((line = b.readLine()) != null) {
                int i = line.indexOf('\t');
                if (i <= 0) continue;
                String values = line.substring(i + 1).trim();
                if (!values.isEmpty()) cj.put(line.substring(0, i), Arrays.asList(values.split(" +")));
            }
        } catch (Exception ignored) {
            cj.put("hqi", Arrays.asList("我"));
            cj.put("o", Arrays.asList("人","你","他"));
        }
    }

    private void loadZhuyin() {
        try (BufferedReader b = new BufferedReader(new InputStreamReader(
                getContext().getAssets().open("zhuyin.tsv"), StandardCharsets.UTF_8))) {
            String line;
            while ((line = b.readLine()) != null) {
                int i = line.indexOf('\t');
                if (i <= 0) continue;
                String values = line.substring(i + 1).trim();
                if (!values.isEmpty()) zy.put(line.substring(0, i), Arrays.asList(values.split(" +")));
            }
        } catch (Exception ignored) {
            zy.put("ㄨㄛˇ", Arrays.asList("我"));
            zy.put("ㄋㄧˇ", Arrays.asList("你","妳","擬"));
        }
    }

    @Override protected void onDraw(Canvas c) {
        super.onDraw(c);
        hits.clear();
        p.setStyle(Paint.Style.FILL);
        p.setColor(BG);
        c.drawRect(0, 0, getWidth(), getHeight(), p);

        if (page == Page.EMOJI) {
            drawEmoji(c);
            syncComposition();
            return;
        }
        if (page == Page.KAOMOJI) {
            drawKaomoji(c);
            syncComposition();
            return;
        }

        if (page == Page.MAIN) {
            if (mode == Mode.CANGJIE) drawCangjie(c);
            else if (mode == Mode.ENGLISH) drawEnglish(c);
            else drawZhuyin(c);
        } else if (page == Page.NUM) {
            drawNumbers(c);
        } else {
            drawSymbols(c);
        }
        drawFooter(c);
        // Candidate panel is drawn last so expanded rows really cover the keyboard body.
        drawCandidates(c);
        if (modeMenu) drawModeMenu(c);
        syncComposition();
    }

    private void drawKey(Canvas c, float x1, float y1, float x2, float y2,
                         String label, float size, String action, String value) {
        RectF r = rect(x1, y1, x2, y2);
        p.setColor(Color.WHITE);
        c.drawRoundRect(r, dp(8), dp(8), p);
        if (label != null && !label.isEmpty()) {
            t.setColor(Color.BLACK);
            t.setTextAlign(Paint.Align.CENTER);
            t.setTextSize(dp(size * keyScale()));
            android.graphics.Rect bounds = new android.graphics.Rect();
            t.getTextBounds(label, 0, label.length(), bounds);
            float baseline = r.centerY() - (bounds.top + bounds.bottom) / 2f;
            c.drawText(label, r.centerX(), baseline, t);
        }
        if (action != null) hits.add(new Hit(new RectF(r), action, value));
    }

    private void drawCangjie(Canvas c) {
        // Keep every keycap size unchanged. Root glyphs are 85% of their v0.6 size.
        for (int i=0;i<10;i++) { float x=18+i*116.4f; drawKey(c,x,0,x+96,122,c1[i],17.68f,"CJ",String.valueOf(k1[i])); }
        for (int i=0;i<9;i++) { float x=76+i*114.8f; drawKey(c,x,155,x+96,282,c2[i],17.68f,"CJ",String.valueOf(k2[i])); }

        // Add ， to the left of 重 and 。 to the right of 一 without changing key sizes.
        final float thirdGap = 137f / 9f;
        float x = 18f;
        drawKey(c,x,318,x+96,444,"，",21f,"PUNCT","，");
        x += 96f + thirdGap;
        for (int i=0;i<7;i++) {
            drawKey(c,x,318,x+96,444,c3[i],17.0f,"CJ",String.valueOf(k3[i]));
            x += 96f + thirdGap;
        }
        drawKey(c,x,318,x+96,444,"。",21f,"PUNCT","。");
        x += 96f + thirdGap;
        drawKey(c,x,318,x+133,444,"⌫",24,"BACK","");
        drawBottom(c,"123","倉");
    }

    private void drawEnglish(Canvas c) {
        for (int i=0;i<10;i++) { float x=18+i*116.4f; drawKey(c,x,0,x+96,122,q1[i],27,"LETTER",q1[i]); }
        for (int i=0;i<9;i++) { float x=76+i*114.8f; drawKey(c,x,155,x+96,282,q2[i],27,"LETTER",q2[i]); }
        drawKey(c,18,318,145,444,caps?"⇧•":"⇧",25,"SHIFT","");
        for (int i=0;i<7;i++) { float x=172+i*116.2f; drawKey(c,x,318,x+96,444,q3[i],27,"LETTER",q3[i]); }
        drawKey(c,1017,318,1150,444,"⌫",24,"BACK","");
        drawBottom(c,"123","A");
    }

    private void drawZhuyin(Canvas c) {
        for (int i=0;i<11;i++) { float x=18+i*103.3f; drawKey(c,x,0,x+88,108,z1[i],25,"ZY",z1[i]); }
        for (int i=0;i<10;i++) { float x=55+i*105.5f; drawKey(c,x,122,x+88,236,z2[i],25,"ZY",z2[i]); }
        for (int i=0;i<10;i++) { float x=82+i*101.5f; drawKey(c,x,252,x+88,365,z3[i],25,"ZY",z3[i]); }
        for (int i=0;i<10;i++) { float x=18+i*103.4f; drawKey(c,x,382,x+88,494,z4[i],24,"ZY",z4[i]); }
        drawKey(c,1060,382,1150,494,"⌫",22,"BACK","");
        drawBottom(c,"123","注");
    }

    private void drawBottom(Canvas c, String left, String mark) {
        drawKey(c,18,518,145,647,left,left.length()>3?15:22,"NUM","");
        drawKey(c,160,518,287,647,"☺",23,"EMOJI","");
        drawKey(c,303,518,864,647,"",22,"SPACE","");
        drawKey(c,880,518,1150,647,"↩",25,"ENTER","");
        t.setColor(Color.rgb(190,190,194));
        t.setTextSize(dp(12));
        t.setTextAlign(Paint.Align.RIGHT);
        c.drawText(mark,sx(842),sy(626),t);
    }

    private void drawNumbers(Canvas c) {
        for (int i=0;i<10;i++) { float x=18+i*116.4f; drawKey(c,x,0,x+96,122,String.valueOf((i+1)%10),25,"NUMBER",String.valueOf((i+1)%10)); }
        String[] row2 = mode==Mode.ENGLISH ? en2 : cn2;
        for (int i=0;i<10;i++) { float x=18+i*116.4f; drawKey(c,x,155,x+96,282,row2[i],22,"PUNCT",row2[i]); }

        String[] row3 = mode==Mode.ENGLISH ?
                new String[]{"🔣",".",",","?","!","'"} :
